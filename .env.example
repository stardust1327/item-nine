# Copy to .env and fill in. .env is git-ignored.

# Required for market odds: https://the-odds-api.com/
ODDS_API_KEY=

# Required for LLM scouting reports (src/report_generator.py): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternative LLM provider listed in CLAUDE.md (not used yet)
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# NFL_START_SEASON=2016
# LOG_LEVEL=INFO
# ODDS_BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us,espnbet,betrivers,fanatics,hardrockbet
# ODDS_CONSENSUS_METHOD=median
# NFL_WEEKLY_REFRESH_WEEKDAY=1        # 0=Mon ... 6=Sun
# NFL_WEEKLY_REFRESH_HOUR_UTC=12
# NFL_SPREAD_MARGIN_SIGMA=13.45
# NFL_DATA_DIR=./data
# GEMINI_MODEL=gemini-2.5-flash
# Confidence tiers (src/model.py). Each payload records the thresholds it was built with.
# NFL_TIER_LOCK_MIN_WIN_PROB=0.75
# NFL_STAT_MISMATCH_MIN_PCT=8.0       # |model - market| on the pick, in percentage points
# NFL_STAT_MISMATCH_MAX_PER_WEEK=2     # STAT MISMATCH games per week, largest gaps first
# NFL_TIER_LEAN_MIN_WIN_PROB=0.55
