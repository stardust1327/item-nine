# Copy to .env and fill in. .env is git-ignored.

# Required for market odds: https://the-odds-api.com/
ODDS_API_KEY=

# Optional overrides (defaults shown)
# NFL_START_SEASON=2016
# LOG_LEVEL=INFO
# ODDS_BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us,espnbet,betrivers,fanatics,hardrockbet
# ODDS_CONSENSUS_METHOD=median
# NFL_WEEKLY_REFRESH_WEEKDAY=1        # 0=Mon ... 6=Sun
# NFL_WEEKLY_REFRESH_HOUR_UTC=12
# NFL_SPREAD_MARGIN_SIGMA=13.45
# NFL_DATA_DIR=./data
